# Local development credentials only. Copy to .env and adjust as needed.
# No spaces around '=' — Compose treats them as part of the key/value.

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=fincore
POSTGRES_USER=fincore_app
POSTGRES_PASSWORD=fincore_app
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/fincore
DB_USERNAME=fincore_app
DB_PASSWORD=fincore_app
